{
  "name": "feriwala-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "admin:add": "tsx src/scripts/addAdmin.ts",
    "admin:delete": "tsx src/scripts/deleteAdmin.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:cleanup": "tsx src/scripts/cleanup.ts",
    "db:find": "tsx src/scripts/findAllData.ts"
  },
  "dependencies": {
    "better-auth": "1.6.27",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "mongodb": "^7.3.0",
    "mongoose": "^9.7.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.11",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
